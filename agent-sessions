#!/usr/bin/env python3
"""Claude Code / Codex / pi / Grok Bot の直近セッションを、AgentSessions.app なしで一覧する。"""
import argparse
import base64
import glob
import json
import os
import re
import sys
from datetime import datetime

HOME = os.path.expanduser("~")
CLAUDE_DIR = os.path.join(HOME, ".claude", "projects")
CODEX_DIR = os.path.join(HOME, ".codex", "sessions")
CODEX_INDEX = os.path.join(HOME, ".codex", "session_index.jsonl")
PI_DIR = os.path.join(HOME, ".pi", "agent", "sessions")
GROK_CACHE = os.path.join(HOME, "Library", "Application Support", "Grok Bot", "sand-client-persistence")
TAIL_BYTES = 512 * 1024
CODEX_ID = re.compile(r"T\d\d-\d\d-\d\d-([0-9a-f-]{36})")


def tail_lines(path):
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - TAIL_BYTES))
        return f.read().decode("utf-8", "replace").splitlines()


def reversed_file(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return reversed(f.readlines())


def parse(line):
    try:
        return json.loads(line)
    except ValueError:
        return None


def claude_sessions():
    for path in glob.glob(os.path.join(CLAUDE_DIR, "*", "*.jsonl")):
        yield "claude", os.path.getmtime(path), lambda path=path: claude_detail(path)


def codex_sessions():
    titles = codex_titles()
    latest = {}
    for path in glob.glob(os.path.join(CODEX_DIR, "*", "*", "*", "*.jsonl")):
        mtime = os.path.getmtime(path)
        # 分割された rollout ファイルはファイル名のセッションIDでまとめる
        m = CODEX_ID.search(os.path.basename(path))
        key = m.group(1) if m else path
        if key not in latest or mtime > latest[key][1]:
            latest[key] = (path, mtime)
    for path, mtime in latest.values():
        yield "codex", mtime, lambda path=path: codex_detail(path, titles)


def pi_sessions():
    for path in glob.glob(os.path.join(PI_DIR, "*", "*.jsonl")):
        yield "pi", os.path.getmtime(path), lambda path=path: pi_detail(path)


def grok_sessions():
    # Grok Bot は会話をサーバー側に持つため、アプリが手元に残すボット一覧のキャッシュを読む
    for path in glob.glob(os.path.join(GROK_CACHE, "*.blob")):
        name = os.path.basename(path)[:-5].upper()
        try:
            key = base64.b32decode(name + "=" * (-len(name) % 8)).decode()
        except ValueError:
            continue
        if not key.endswith(".roster.last-roster"):
            continue
        with open(path, encoding="utf-8", errors="replace") as f:
            rows = ((parse(f.read()) or {}).get("value") or {}).get("rows") or []
        for row in rows:
            if row.get("lastActivityAt"):
                yield "grok", row["lastActivityAt"] / 1000, lambda row=row: grok_detail(row)


def claude_detail(path):
    info = {"id": os.path.basename(path)[:-6], "cwd": "", "model": "", "title": ""}
    custom = ai = ""
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            if not info["cwd"] and '"cwd"' in line:
                info["cwd"] = (parse(line) or {}).get("cwd", "")
            if '"type":"custom-title"' in line:
                custom = (parse(line) or {}).get("customTitle", custom)
            elif '"type":"ai-title"' in line:
                ai = (parse(line) or {}).get("aiTitle", ai)
    for line in reversed(tail_lines(path)):
        if '"type":"assistant"' in line:
            model = ((parse(line) or {}).get("message") or {}).get("model")
            if model and model != "<synthetic>":
                info["model"] = model
                break
    info["title"] = custom or ai
    return info, True, path


def codex_titles():
    titles = {}
    if os.path.exists(CODEX_INDEX):
        with open(CODEX_INDEX, encoding="utf-8", errors="replace") as f:
            for line in f:
                row = parse(line) or {}
                if row.get("id") and row.get("thread_name"):
                    titles[row["id"]] = row["thread_name"]
    return titles


def codex_detail(path, titles):
    with open(path, encoding="utf-8", errors="replace") as f:
        meta = (parse(f.readline()) or {}).get("payload", {})
    info = {"id": meta.get("id", ""), "cwd": meta.get("cwd", ""), "model": "", "title": titles.get(meta.get("id"), "")}
    for lines in (reversed(tail_lines(path)), reversed_file(path)):
        line = next((l for l in lines if '"type":"turn_context"' in l), None)
        if line:
            info["model"] = ((parse(line) or {}).get("payload") or {}).get("model", "")
            break
    # Guardian review などのサブエージェントは除外する
    return info, meta.get("thread_source", "user") == "user", path


def pi_detail(path):
    info = {"id": "", "cwd": "", "model": "", "title": ""}
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            if '"type":"session"' in line and not info["id"]:
                head = parse(line) or {}
                info["id"], info["cwd"] = head.get("id", ""), head.get("cwd", "")
            elif '"type":"session_info"' in line:
                info["title"] = (parse(line) or {}).get("name") or info["title"]
            elif '"customType":"brayness-session-title"' in line:
                info["title"] = ((parse(line) or {}).get("data") or {}).get("title") or info["title"]
            elif '"type":"model_change"' in line:
                info["model"] = (parse(line) or {}).get("modelId") or info["model"]
    return info, True, path


def grok_detail(row):
    last = " ".join(((row.get("lastEntry") or {}).get("text") or "").split())
    title = row.get("name", "") + (f" — {last[:60]}" if last else "")
    return {"id": row.get("id", ""), "cwd": "", "model": "", "title": title}, True, row.get("path", "")


SOURCES = {"claude": claude_sessions, "codex": codex_sessions, "pi": pi_sessions, "grok": grok_sessions}


def main():
    p = argparse.ArgumentParser(description="直近の Claude Code / Codex / pi / Grok Bot セッションを一覧する")
    p.add_argument("-n", type=int, default=15, help="表示件数（既定: 15）")
    p.add_argument("-s", "--source", choices=list(SOURCES), help="エージェントで絞り込む")
    p.add_argument("-d", "--cwd", help="作業ディレクトリで絞り込む（前方一致）")
    p.add_argument("--json", action="store_true", help="JSON Lines で出力する")
    args = p.parse_args()

    candidates = []
    for name, collect in SOURCES.items():
        if args.source in (None, name):
            candidates += collect()
    candidates.sort(key=lambda c: c[1], reverse=True)

    cwd_filter = os.path.abspath(os.path.expanduser(args.cwd)) if args.cwd else None
    rows = []
    for source, mtime, load in candidates:
        if len(rows) >= args.n:
            break
        info, keep, path = load()
        if not keep or (cwd_filter and not info["cwd"].startswith(cwd_filter)):
            continue
        rows.append({"source": source, "updated": datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M"), **info, "path": path})

    if args.json:
        for row in rows:
            print(json.dumps(row, ensure_ascii=False))
        return
    for row in rows:
        cwd = row["cwd"].replace(HOME, "~", 1) or ("(Grok Bot)" if row["source"] == "grok" else "")
        print(f'{row["updated"]}  {row["source"]:<6}  {row["model"][:18]:<18}  {cwd[:45]:<45}  {row["title"] or "(無題)"}')


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
